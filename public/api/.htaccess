# ========================================
# PUBLIC JSON API (described by /openapi.json)
# ========================================
# Self-contained: a RewriteEngine here replaces the root rules for /api/.

# Errors are RFC 9457 problem details, not HTML pages
ErrorDocument 404 /api/errors/404.json
ErrorDocument 405 /api/errors/405.json

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # Same www -> apex redirect as the rest of the site
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Read-only API (the 405 error document itself is exempt, or its own
  # ErrorDocument pass, still carrying the client's method, would loop)
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteCond %{REQUEST_URI} !^/api/errors/
  RewriteRule ^ - [R=405,L]

  # errors/*.json stay reachable directly: blocking them would also block the
  # ErrorDocument pass on LiteSpeed, which does not set REDIRECT_STATUS.

  # /api/ -> index.json, /api/profile -> profile.json
  RewriteRule ^$ index.json [L]
  RewriteCond %{REQUEST_FILENAME}.json -f
  RewriteRule ^([a-z-]+)$ $1.json [L]
</IfModule>

<IfModule mod_headers.c>
  # Read-only public data: any origin may fetch it
  Header always set Access-Control-Allow-Origin "*"
  Header always set Allow "GET, HEAD, OPTIONS"
</IfModule>
