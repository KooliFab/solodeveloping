# ========================================
# CONTENT TYPES
# ========================================

# Markdown mirrors of every page, generated at build time (scripts/agent)
AddType text/markdown .md
AddCharset utf-8 .md

# OpenAPI description in YAML (openapi.yaml, api/openapi.yaml)
AddType application/yaml .yaml

# ========================================
# PERFORMANCE OPTIMIZATIONS
# ========================================

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript text/markdown
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE application/problem+json application/linkset+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Enable Brotli Compression (better than Gzip, if available)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript text/markdown
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/problem+json application/linkset+json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS and JavaScript - 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Fonts - 1 year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML and its Markdown mirrors - 1 hour
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/markdown "access plus 1 hour"

  # JSON - no cache
  ExpiresByType application/json "access plus 0 seconds"

  # Default
  ExpiresDefault "access plus 1 month"
</IfModule>

# Cache-Control Headers
<IfModule mod_headers.c>
  # Static assets - aggressive caching with immutable
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # CSS and JS - aggressive caching with immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML and Markdown - short cache with revalidation
  <FilesMatch "\.(html|htm|md)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>

  # Pages are negotiated between HTML and Markdown on the Accept header
  <FilesMatch "\.(html|md)$">
    Header merge Vary "Accept"
  </FilesMatch>

  # Advertise the API catalog (RFC 9727) on every page
  <FilesMatch "\.html$">
    Header add Link "</.well-known/api-catalog>; rel=api-catalog"
  </FilesMatch>

  # The API description can be fetched from any origin ("always", like the
  # api/.htaccess header, so the copies under /api/ get it once, not twice)
  <FilesMatch "^openapi\.(json|yaml)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # LiteSpeed (Hostinger) ignores AddCharset: set the Markdown charset here
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.yaml$">
    Header set Content-Type "application/yaml; charset=utf-8"
  </FilesMatch>

  # JSON 404 body (RFC 9457) for clients asking for JSON, negotiated like
  # the Markdown one
  <Files "404.json">
    Header set Content-Type "application/problem+json"
    Header merge Vary "Accept"
  </Files>

  # Error documents and react-snap's SPA shell stay reachable at their own
  # URL (LiteSpeed cannot tell a direct request from the ErrorDocument pass),
  # so keep them out of search results instead
  <FilesMatch "^(404\.html|404\.md|404\.json|200\.html)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:"

  # Remove server info for security
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# Disable ETags (using Cache-Control instead)
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# ========================================
# ROUTING & REDIRECTS
# ========================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle www and non-www versions
  # If accessing via www subdomain, continue with normal processing
  # RewriteCond %{HTTP_HOST} ^www\. [NC]

  # Redirect www to non-www while preserving path and query string
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 301 Redirects: Migrated blog posts to short articles
  RewriteRule ^articles/why-i-dont-build-saas-around-ai-api-keys$ /shorts/why-i-dont-build-saas-around-ai-api-keys [R=301,L]
  RewriteRule ^fr/articles/why-i-dont-build-saas-around-ai-api-keys$ /fr/shorts/why-i-dont-build-saas-around-ai-api-keys [R=301,L]

  # 301 Redirects: Old article slugs still crawled by Google
  RewriteRule ^articles/the-power-of-lazy-loading$ /articles/flutter-firebase-lazy-loading [R=301,L]
  RewriteRule ^articles/how-to-successfully-wake-up-earlier$ /articles [R=301,L]

  # Short posts have no index page of their own
  RewriteRule ^shorts/?$ /articles [R=301,L]
  RewriteRule ^fr/shorts/?$ /fr/articles [R=301,L]

  # ---- Markdown content negotiation (https://acceptmarkdown.com) ----
  # SD_MD=1 when the client prefers Markdown: text/markdown is listed, not
  # refused with q=0, and not ranked below an unqualified text/html.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{HTTP:Accept} !text/markdown\s*;\s*q=0(\.0{0,3})?\s*(,|;|$) [NC]
  RewriteCond %{HTTP:Accept} !text/markdown\s*;\s*q=0?\.\d+ [NC,OR]
  RewriteCond %{HTTP:Accept} !text/html\s*(,|$) [NC]
  RewriteRule ^ - [E=SD_MD:1]

  # 404 error pass: agents asking for Markdown get the Markdown 404 body.
  # The ErrorDocument pass is recognized by its URI (/404.html) differing
  # from the client's request line: LiteSpeed (Hostinger) does not set
  # REDIRECT_STATUS like Apache does.
  RewriteCond %{ENV:SD_MD} =1
  RewriteCond %{THE_REQUEST} !^\S+\s+/404\.html[\s?] [NC]
  RewriteRule ^404\.html$ 404.md [L]

  # Same for clients asking for JSON (API clients, agents): JSON is listed
  # and neither HTML nor Markdown is, so browsers keep the HTML page.
  RewriteCond %{HTTP:Accept} (application/json|application/problem\+json) [NC]
  RewriteCond %{HTTP:Accept} !(text/html|text/markdown) [NC]
  RewriteCond %{THE_REQUEST} !^\S+\s+/404\.html[\s?] [NC]
  RewriteRule ^404\.html$ 404.json [L]

  # "/" and "/fr/" -> index.html.md inside that directory
  RewriteCond %{ENV:SD_MD} =1
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html.md -f
  RewriteRule ^(.*?)/?$ $1/index.html.md [L]

  # "/about", "/articles/<slug>" (with or without trailing slash) -> about.md
  RewriteCond %{ENV:SD_MD} =1
  RewriteCond %{REQUEST_FILENAME} ^(.+?)/*$
  RewriteCond %1.md -f
  RewriteRule ^(.+?)/*$ $1.md [L]

  # 406 for a page when the client accepts neither HTML nor Markdown
  RewriteCond %{HTTP:Accept} .
  RewriteCond %{HTTP:Accept} !(text/html|text/markdown|text/\*|\*/\*|application/xhtml\+xml) [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [R=406,L]

  # The JSON API under /api/ has its own rules in api/.htaccess.

  # Every route is prerendered to <route>/index.html, so there is no SPA
  # fallback: unknown URLs get a real 404 (see ErrorDocument below).
</IfModule>

# Unknown URLs: real 404 status with the prerendered "not found" page
# (or 404.md / 404.json for Markdown / JSON clients, see the rewrite rules above)
ErrorDocument 404 /404.html
